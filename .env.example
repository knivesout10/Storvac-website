# Copy this file to .env and fill in your real values. Never commit .env to git.

PORT=3000

# Generate any long random string for this (e.g. run: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# Paystack keys — from your Paystack Dashboard > Settings > API Keys & Webhooks
# Use the TEST keys while building, and swap to LIVE keys only when you go live.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Owner/admin login for the Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# mNotify — used to send booking codes & receipts by SMS (the main receipt channel)
# Get your API key from your mNotify/BMS Africa dashboard: https://apps.mnotify.net/
MNOTIFY_API_KEY=replace-with-your-mnotify-api-key
# Sender ID shown as the sender name — max 11 characters, letters/numbers only
MNOTIFY_SENDER_ID=StorVac
